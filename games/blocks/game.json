{
  "name": "blocks",
  "title": "Blocks",
  "original": {
    "repo": "jakesgordon/javascript-tetris",
    "license": "MIT",
    "path": "originals/blocks"
  },
  "record": "record.mjs",
  "ports": {
    "web": {
      "cmd": [
        "node",
        "ports/web/run.mjs"
      ],
      "play": "ports/web/index.html"
    },
    "godot": {
      "cmd": [
        "godot",
        "--headless",
        "--path",
        "ports/godot",
        "--script",
        "runner.gd"
      ]
    },
    "bevy": {
      "build": [
        "cargo",
        "build",
        "--release",
        "--quiet",
        "--manifest-path",
        "ports/bevy/Cargo.toml",
        "-p",
        "blocks-runner"
      ],
      "cmd": [
        "ports/bevy/target/release/blocks-runner"
      ]
    }
  }
}
